# Variables d'environnement AGRISAMA IA — Modèle de configuration (Supabase Full-Stack)
# Copiez ce fichier vers .env (ne jamais commiter .env)

# Supabase PostgreSQL (Transaction Pooler port 6543 + Session Pooler port 5432)
DATABASE_URL="postgresql://agrisama_app.<PROJECT_REF>:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&sslmode=require"
DIRECT_URL="postgresql://agrisama_app.<PROJECT_REF>:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Clés projet Supabase
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Clé secrète de signature des cookies de session (64 caractères hexadécimaux aléatoires)
SESSION_SECRET="remplacer-par-une-cle-aleatoire-de-64-caracteres"

# Configuration applicative
NEXT_PUBLIC_APP_NAME="AGRISAMA AI"
NEXT_PUBLIC_SUPPORT_WHATSAPP="221770001122"

# Compte Administrateur privé (/admin)
ADMIN_NAME="Administrateur AgriSama IA"
ADMIN_PHONE="+221 77 900 10 00"
ADMIN_PASSWORD="remplacer-par-un-mot-de-passe-fort"
